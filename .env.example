# Copy to .env for local development. Everything is optional locally: with no Sanity
# project the site builds from seed/content.json.

# Public (baked into the client bundle)
PUBLIC_SITE_URL=https://samridhiagarwal.com
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_STREAM_CUSTOMER_CODE=         # from Cloudflare Stream dashboard, e.g. abc123def
PUBLIC_TURNSTILE_SITE_KEY=           # Turnstile widget site key

# Server-only (set with `wrangler secret put NAME` in production)
SANITY_READ_TOKEN=                   # only needed if the dataset is private
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL=hello@samridhiagarwal.com   # where enquiries are sent
FROM_EMAIL=studio@samridhiagarwal.com    # verified sender domain in Resend
