# Local development secrets go in .dev.vars (read by wrangler dev and astro dev), e.g.:
#   ADMIN_PASSWORD=local
#   SESSION_SECRET=<long random string>
# Optional values below can also go there.

# Public (baked into the client bundle)
PUBLIC_SITE_URL=https://samridhiagarwal.com
PUBLIC_TURNSTILE_SITE_KEY=           # Turnstile widget site key

# Server-only (set with `wrangler secret put NAME` in production)
ADMIN_PASSWORD=                      # password for /admin
SESSION_SECRET=                      # signs admin login cookies
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL=hello@samridhiagarwal.com   # where enquiries are sent
FROM_EMAIL=studio@samridhiagarwal.com    # verified sender domain in Resend
