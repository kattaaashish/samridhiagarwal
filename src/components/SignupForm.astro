---
/** "Be the first to know" email sign-up. Posts to /api/subscribe. */
import Turnstile from './Turnstile.astro';
import FormStatus from './FormStatus.astro';
import { pagePath } from '@/lib/format';
interface Props { topic: string; label?: string; class?: string; compact?: boolean }
const { topic, label = 'Be the first to know', class: className = '', compact = false } = Astro.props;
const id = `signup-${topic.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
---
<form method="post" action="/api/subscribe" class={`grid gap-3 ${className}`} data-enhanced-form>
  <input type="hidden" name="topic" value={topic} />
  <input type="hidden" name="_redirect" value={pagePath(Astro.url)} />
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <label for={id} class={compact ? 'sr-only' : 'font-medium'}>{label}</label>
  <div class="flex flex-col gap-2 sm:flex-row">
    <input id={id} class="input flex-1" type="email" name="email" required autocomplete="email" placeholder="you@example.com" />
    <button class="btn btn-primary" type="submit">Notify me</button>
  </div>
  <Turnstile />
  <FormStatus successText="You're on the list. I'll write to you first." />
</form>
