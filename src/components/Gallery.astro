---
/**
 * Artwork / exhibition gallery: main Media + thumbnails, every frame opens the Lightbox.
 * Provides the JSON group the lightbox reads. Works as static links without JS? The
 * buttons need JS for zoom; posters remain fully visible without it.
 */
import Media from './Media.astro';
import type { MediaRef } from '@/lib/types';
interface Props { items: MediaRef[]; groupId: string; mainAspect?: number; priority?: boolean; layout?: 'stack' | 'grid' }
const { items, groupId, mainAspect, priority = true, layout = 'stack' } = Astro.props;
const json = JSON.stringify(items.map((m) => ({ src: m.poster.src, srcset: m.poster.srcset ?? m.poster.modernSrcset, alt: m.alt, width: m.poster.width, height: m.poster.height })));
---
<div class="gallery" data-gallery>
  {layout === 'stack' ? (
    <>
      <button type="button" class="block w-full overflow-hidden rounded-xl shimmer text-left" data-lightbox={groupId} data-index="0" aria-label={`Open ${items[0]?.alt ?? 'image'} in the zoomable viewer`}>
        <Media media={items[0]} aspect={mainAspect} sizes="(min-width: 1024px) 58vw, 100vw" priority={priority} />
      </button>
      {items.length > 1 && (
        <div class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4">
          {items.slice(1).map((m, i) => (
            <button type="button" class="overflow-hidden rounded-lg shimmer" data-lightbox={groupId} data-index={i + 1} aria-label={`Open ${m.alt} in the zoomable viewer`}>
              <Media media={m} aspect={1} sizes="(min-width: 1024px) 14vw, 30vw" />
            </button>
          ))}
        </div>
      )}
    </>
  ) : (
    <div class="grid grid-cols-2 gap-3 md:grid-cols-3" data-stagger>
      {items.map((m, i) => (
        <button type="button" class="reveal overflow-hidden rounded-xl shimmer" data-lightbox={groupId} data-index={i} aria-label={`Open ${m.alt} in the viewer`}>
          <Media media={m} aspect={3 / 2} sizes="(min-width: 768px) 30vw, 50vw" />
        </button>
      ))}
    </div>
  )}
  <script type="application/json" data-lightbox-group={groupId} set:html={json} />
</div>
