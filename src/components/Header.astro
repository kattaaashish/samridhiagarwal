---
import { getSite } from '@/lib/data';
import { pagePath } from '@/lib/format';
const { collections, occasions, settings } = await getSite();
const path = pagePath(Astro.url);
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

// Submenus are generated from content — zero code changes when collections/occasions change.
const workMenu = [
  { label: 'Originals', href: '/work', desc: 'Every available piece' },
  { label: 'Collections', href: '/work#collections', children: collections.map((c) => ({ label: c.name, href: `/collections/${c.slug}` })) },
  { label: 'Gifting', href: '/gifting', children: occasions.map((o) => ({ label: o.name, href: `/gifting/${o.slug}` })) },
  { label: 'Commissions', href: '/commissions', desc: 'A piece about your moment' },
];
const topLevel = [
  { label: 'Exhibitions', href: '/exhibitions' },
  { label: 'About', href: '/about' },
  { label: 'Journal', href: '/journal' },
  { label: 'Contact', href: '/contact' },
];
---
<header class="header sticky top-0 z-50 bg-bg/90 backdrop-blur-md transition-shadow" data-header data-open="false">
  <div class="container-x flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="font-display text-[1.35rem] leading-none tracking-tight lg:text-2xl" aria-label={`${settings.siteName}, home`}>
      {settings.siteName}
    </a>

    <button type="button" class="btn btn-ghost min-h-10 px-4 py-2 text-sm lg:hidden" data-menu-toggle aria-expanded="false" aria-controls="site-menu">
      <span data-label>Menu</span>
    </button>

    <nav id="site-menu" class="menu-panel" data-menu-panel aria-label="Main">
      <ul class="menu-list">
        <li class="menu-item">
          <button type="button" class="menu-link" data-submenu-toggle aria-expanded="false" aria-controls="submenu-work">
            Work <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <div class="submenu" id="submenu-work">
            <div class="submenu-grid">
              {workMenu.map((group) => (
                <div>
                  <a href={group.href} class="submenu-heading">{group.label}</a>
                  {group.desc && <p class="text-sm text-muted">{group.desc}</p>}
                  {group.children && group.children.length > 0 && (
                    <ul class="mt-2 grid gap-1">
                      {group.children.map((c) => <li><a href={c.href} class="submenu-link">{c.label}</a></li>)}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </div>
        </li>
        {topLevel.map((item) => (
          <li class="menu-item">
            <a href={item.href} class="menu-link" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="mt-6 flex flex-wrap gap-3 lg:hidden">
        <a href="/commissions" class="btn btn-primary">Start a commission</a>
        {settings.instagram && <a href={settings.instagram} class="btn btn-secondary" rel="noopener" target="_blank">Instagram</a>}
      </div>
    </nav>
  </div>
</header>

<style>
  .header.is-scrolled { box-shadow: 0 1px 0 var(--line); }
  .menu-panel { display: none; }
  .header[data-open='true'] .menu-panel {
    display: block; position: fixed; inset: 4rem 0 0 0; overflow-y: auto; background: var(--bg); padding: 1rem clamp(1rem, 4vw, 3rem) 3rem;
  }
  .menu-list { display: grid; gap: .25rem; }
  .menu-item { position: relative; }
  .menu-link {
    display: inline-flex; align-items: center; gap: .35rem; padding: .85rem 0; font-size: 1.375rem; font-family: var(--font-display); background: none; border: 0; cursor: pointer;
    text-decoration: none; width: 100%; text-align: left;
  }
  .menu-link[aria-current='page'] { color: var(--accent-ink); }
  .submenu { display: none; padding: .25rem 0 1rem; }
  [data-submenu-toggle][aria-expanded='true'] + .submenu { display: block; }
  [data-submenu-toggle][aria-expanded='true'] svg { transform: rotate(180deg); }
  .submenu-grid { display: grid; gap: 1.25rem; }
  .submenu-heading { font-weight: 500; text-decoration: none; }
  .submenu-heading:hover { color: var(--accent-ink); }
  .submenu-link { display: block; padding: .3rem 0; color: var(--muted); text-decoration: none; }
  .submenu-link:hover { color: var(--ink); }

  @media (min-width: 1024px) {
    .menu-panel { display: block; position: static; }
    .header[data-open='true'] .menu-panel { position: static; inset: auto; padding: 0; }
    .menu-list { display: flex; gap: 1.75rem; align-items: center; }
    .menu-link { font-size: 1rem; font-family: var(--font-body); padding: .5rem 0; width: auto; position: relative; }
    .menu-link::after { content: ''; position: absolute; left: 0; right: 100%; bottom: .15rem; height: 1px; background: currentColor; transition: right .3s var(--ease-out); }
    .menu-link:hover::after, .menu-link[aria-current='page']::after { right: 0; }
    .submenu {
      position: absolute; top: 100%; left: -1.5rem; min-width: 44rem; padding: 1.5rem; margin-top: .5rem;
      background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 20px 50px -20px rgb(31 27 24 / .3);
    }
    .submenu-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
    .submenu-heading { font-family: var(--font-display); font-size: 1.15rem; }
    .submenu-link { font-size: .95rem; }
  }
</style>
