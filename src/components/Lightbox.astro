---
/**
 * Accessible lightbox <dialog> shared by artwork galleries and exhibition galleries.
 * Keyboard: Esc closes, ←/→ move, +/- and 0 zoom. Mouse wheel and pinch zoom, drag to pan.
 * Trigger buttons: <button data-lightbox="groupId" data-index="n">. Group data comes from
 * a <script type="application/json" data-lightbox-group="groupId">.
 */
---
<dialog class="lightbox" data-lightbox-dialog aria-label="Image viewer">
  <div class="lb-toolbar">
    <p class="lb-caption" data-lb-caption></p>
    <div class="lb-actions">
      <button type="button" class="lb-btn" data-lb-zoom-out aria-label="Zoom out">−</button>
      <button type="button" class="lb-btn" data-lb-zoom-in aria-label="Zoom in">+</button>
      <button type="button" class="lb-btn" data-lb-close aria-label="Close viewer">✕</button>
    </div>
  </div>
  <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Previous image">‹</button>
  <div class="lb-stage" data-lb-stage>
    <img class="lb-img" data-lb-img alt="" draggable="false" />
  </div>
  <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Next image">›</button>
  <p class="lb-hint" data-lb-hint>Pinch or scroll to zoom. Drag to pan.</p>
</dialog>
<script src="@/scripts/lightbox.ts"></script>

<style is:global>
  .lightbox { max-width: 100vw; max-height: 100dvh; width: 100vw; height: 100dvh; margin: 0; padding: 0; border: 0; background: var(--ink); color: var(--bg); overflow: hidden; }
  .lightbox[open] { display: grid; grid-template-rows: auto 1fr auto; grid-template-columns: auto 1fr auto; }
  .lb-toolbar { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; }
  .lb-caption { font-size: .95rem; opacity: .85; min-height: 1.4em; }
  .lb-actions { display: flex; gap: .5rem; }
  .lb-btn, .lb-nav { min-width: 2.75rem; min-height: 2.75rem; border-radius: 999px; border: 1px solid rgb(251 248 243 / .25); background: rgb(251 248 243 / .08); color: inherit; font-size: 1.25rem; cursor: pointer; }
  .lb-btn:hover, .lb-nav:hover { background: rgb(251 248 243 / .18); }
  .lb-nav { align-self: center; margin: 0 .5rem; font-size: 2rem; line-height: 1; }
  .lb-stage { position: relative; overflow: hidden; touch-action: none; cursor: grab; display: grid; place-items: center; }
  .lb-stage.is-dragging { cursor: grabbing; }
  .lb-img { max-width: 100%; max-height: 100%; object-fit: contain; transform-origin: 0 0; user-select: none; will-change: transform; }
  .lb-hint { grid-column: 1 / -1; text-align: center; font-size: .8rem; opacity: .6; padding: .5rem 1rem .9rem; }
  .lightbox :focus-visible { outline: 3px solid var(--accent-warm); outline-offset: 2px; }
  @media (max-width: 640px) { .lb-nav { position: absolute; bottom: 3rem; } .lb-prev { left: 1rem; } .lb-next { right: 1rem; } .lightbox[open] { grid-template-columns: 0 1fr 0; } }
</style>
