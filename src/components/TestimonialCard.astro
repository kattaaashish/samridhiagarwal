---
import Media from './Media.astro';
import type { Testimonial } from '@/lib/types';
interface Props { t: Testimonial }
const { t } = Astro.props;
---
<figure class="reveal card">
  <Media media={t.photo} aspect={4 / 3} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" />
  <div class="p-5">
    <blockquote class="text-[1.05rem] leading-relaxed">“{t.quote}”</blockquote>
    <figcaption class="mt-3 text-sm text-muted">{t.name}{t.city && `, ${t.city}`}</figcaption>
  </div>
</figure>
