---
import { getSite } from '@/lib/data';
import { whatsappLink } from '@/lib/format';
const { settings, collections, occasions } = await getSite();
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line bg-surface">
  <div class="container-x grid gap-12 py-14 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl">{settings.siteName}</p>
      <p class="mt-3 max-w-sm text-muted">{settings.shortBio}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        {settings.whatsappNumber && <a class="btn btn-secondary min-h-10 px-4 py-2 text-sm" href={whatsappLink(settings.whatsappNumber, 'Hi Samridhi, I found your website and would like to ask about a piece.')} rel="noopener" target="_blank">WhatsApp</a>}
        {settings.instagram && <a class="btn btn-secondary min-h-10 px-4 py-2 text-sm" href={settings.instagram} rel="noopener" target="_blank">Instagram</a>}
        {settings.email && <a class="btn btn-secondary min-h-10 px-4 py-2 text-sm" href={`mailto:${settings.email}`}>Email</a>}
      </div>
    </div>
    <nav aria-label="Work">
      <p class="eyebrow mb-3">Work</p>
      <ul class="grid gap-2">
        <li><a href="/work" class="hover:text-accent-ink">Originals</a></li>
        {collections.map((c) => <li><a href={`/collections/${c.slug}`} class="hover:text-accent-ink">{c.name}</a></li>)}
        <li><a href="/commissions" class="hover:text-accent-ink">Commissions</a></li>
      </ul>
    </nav>
    <nav aria-label="Gifting">
      <p class="eyebrow mb-3">Gifting</p>
      <ul class="grid gap-2">
        <li><a href="/gifting" class="hover:text-accent-ink">All occasions</a></li>
        {occasions.map((o) => <li><a href={`/gifting/${o.slug}`} class="hover:text-accent-ink">{o.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="More">
      <p class="eyebrow mb-3">More</p>
      <ul class="grid gap-2">
        <li><a href="/exhibitions" class="hover:text-accent-ink">Exhibitions</a></li>
        <li><a href="/about" class="hover:text-accent-ink">About</a></li>
        <li><a href="/journal" class="hover:text-accent-ink">Journal</a></li>
        <li><a href="/contact" class="hover:text-accent-ink">Contact</a></li>
        <li><a href="#faqs" class="hover:text-accent-ink">Care, framing, shipping and returns</a></li>
        {settings.etsy && <li><a href={settings.etsy} class="hover:text-accent-ink" rel="noopener" target="_blank">Etsy shop (international)</a></li>}
      </ul>
    </nav>
  </div>

  {settings.footerFaqs.length > 0 && (
    <div class="container-x border-t border-line py-12" id="faqs">
      <h2 class="text-2xl">Care, framing, shipping and returns</h2>
      <div class="mt-6 grid gap-2 lg:grid-cols-2">
        {settings.footerFaqs.map((f) => (
          <details class="group rounded-xl border border-line bg-bg px-5 py-3">
            <summary class="cursor-pointer list-none py-1 font-medium marker:hidden [&::-webkit-details-marker]:hidden flex items-center justify-between gap-4">
              {f.q}
              <span aria-hidden="true" class="text-leaf transition-transform group-open:rotate-45 text-xl leading-none">+</span>
            </summary>
            <p class="pb-2 pt-1 text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  )}

  <div class="container-x flex flex-wrap items-center justify-between gap-3 border-t border-line py-6 text-sm text-muted">
    <p>© {year} {settings.siteName}. All artworks are handmade and copyright the artist.</p>
    <p>Ships across India and worldwide.</p>
  </div>
</footer>
