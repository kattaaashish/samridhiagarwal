---
import Base from '@/layouts/Base.astro';
import Media from '@/components/Media.astro';
import ArtworkGrid from '@/components/ArtworkGrid.astro';
import EnquiryForm from '@/components/EnquiryForm.astro';
import { getSite } from '@/lib/data';
import { artworksIn, seasonalOccasions } from '@/lib/normalize';
import { formatDate } from '@/lib/format';
import type { Occasion } from '@/lib/types';

export async function getStaticPaths() {
  const site = await getSite();
  return site.occasions.map((o) => ({ params: { slug: o.slug }, props: { occasion: o } }));
}
const { occasion } = Astro.props as { occasion: Occasion };
const site = await getSite();
const pieces = artworksIn(site, 'occasion', occasion.id);
const inSeason = seasonalOccasions(site).some((o) => o.id === occasion.id);
const others = site.occasions.filter((o) => o.id !== occasion.id);
---
<Base title={`${occasion.name} gifts`} description={occasion.intro ?? `Art gifts for ${occasion.name} by ${site.settings.siteName}.`} image={occasion.cover?.poster} imageAlt={occasion.cover?.alt}>
  <section class="container-x grid gap-8 pt-8 md:grid-cols-[1fr_1.4fr] md:items-end md:pt-14">
    <Media media={occasion.cover} aspect={4 / 5} sizes="(min-width: 768px) 40vw, 100vw" priority class="rounded-xl" />
    <div class="reveal">
      <p class="eyebrow"><a href="/gifting" class="hover:text-ink">Gifting</a> · Occasion</p>
      <h1 class="mt-3 text-4xl md:text-5xl">{occasion.name}</h1>
      {inSeason && <p class="mt-3"><span class="badge badge-season">This season</span>{occasion.seasonEnd && <span class="ml-2 text-sm text-muted">Order by {formatDate(occasion.seasonEnd)} for delivery in time</span>}</p>}
      {occasion.intro && <p class="mt-5 max-w-xl text-lg text-muted">{occasion.intro}</p>}
    </div>
  </section>
  <section class="container-x mt-14">
    <ArtworkGrid artworks={pieces} filters collections={site.collections} occasions={site.occasions} hide={['occasion']} emptyText="No pieces are tagged for this occasion yet. Tell me what you have in mind below and I'll suggest some." />
  </section>
  <section class="container-x mt-20 grid gap-8 lg:grid-cols-[1fr_1.4fr]" id="enquire">
    <div class="reveal">
      <p class="eyebrow">Gift enquiry</p>
      <h2 class="mt-2 text-3xl">Make it a {occasion.name} gift</h2>
      <p class="mt-3 text-muted">Gift-wrapping and a handwritten note are included on request. Tell me who it's for and I'll help you choose.</p>
    </div>
    <div id="enquiry-form"><EnquiryForm occasions={site.occasions} gifting /></div>
  </section>
  {others.length > 0 && (
    <section class="container-x mt-20">
      <p class="eyebrow mb-4">Other occasions</p>
      <div class="flex flex-wrap gap-2">{others.map((o) => <a href={`/gifting/${o.slug}`} class="chip">{o.name}</a>)}</div>
    </section>
  )}
</Base>
