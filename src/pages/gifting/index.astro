---
import Base from '@/layouts/Base.astro';
import Tile from '@/components/Tile.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ArtworkCard from '@/components/ArtworkCard.astro';
import { getSite } from '@/lib/data';
import { artworksIn, seasonalOccasions } from '@/lib/normalize';
const site = await getSite();
const { occasions, settings } = site;
const seasonal = new Set(seasonalOccasions(site).map((o) => o.id));
---
<Base title="Gifting" description="Meaningful art gifts for Diwali, weddings, new homes, anniversaries and birthdays. Gift-wrapping and a handwritten note included on request. Ships across India and worldwide.">
  <section class="container-x pt-10 md:pt-16">
    <SectionHeading eyebrow="Gifting" title="A piece of an ordinary day, given on a special one" text="Every order can include gift-wrapping and a handwritten note. Tell me the occasion when you enquire and I'll suggest pieces." />
  </section>

  {occasions.length === 0 ? (
    <section class="container-x mt-12"><p class="rounded-xl bg-surface px-6 py-10 text-center text-muted">Gifting occasions are being set up. In the meantime, every original makes a good gift.</p><p class="mt-4 text-center"><a href="/work" class="btn btn-primary">See originals</a></p></section>
  ) : (
    <section class="container-x mt-12">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {occasions.map((o) => (
          <Tile href={`/gifting/${o.slug}`} title={o.name} cta="Explore" media={o.cover} badge={seasonal.has(o.id) ? 'This season' : undefined} class="reveal" aspect={4 / 5} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
        ))}
      </div>
    </section>
  )}

  {occasions.map((o) => {
    const pieces = artworksIn(site, 'occasion', o.id).filter((a) => a.status !== 'sold').slice(0, 4);
    return pieces.length > 0 && (
      <section class="container-x mt-20" aria-labelledby={`occ-${o.slug}`}>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="reveal">
            <h2 id={`occ-${o.slug}`} class="text-3xl">{o.name}</h2>
            {o.intro && <p class="mt-2 max-w-xl text-muted">{o.intro}</p>}
          </div>
          <a href={`/gifting/${o.slug}`} class="link">All {o.name} pieces</a>
        </div>
        <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-4" data-stagger>
          {pieces.map((a) => <ArtworkCard artwork={a} sizes="(min-width: 1024px) 22vw, 45vw" />)}
        </div>
      </section>
    );
  })}

  <section class="container-x mt-24">
    <div class="reveal rounded-xl bg-surface p-8 md:p-12">
      <h2 class="text-3xl">Gift-wrapping and personal notes</h2>
      <p class="mt-3 max-w-2xl text-muted">Every gift is wrapped in handmade paper with a marigold ribbon, and I write your note by hand on a small card. Just tick the box when you enquire. For international gifts, order on <a href={settings.etsy} class="link" rel="noopener" target="_blank">Etsy</a> and mention the note in the order.</p>
      <a href="/contact" class="btn btn-primary mt-6">Enquire about a gift</a>
    </div>
  </section>
</Base>
