---
/**
 * On-demand confirmation page for form posts made without JavaScript.
 * The API redirects here with ?form=…&back=… (and &error=… on failure).
 */
import Base from '@/layouts/Base.astro';
export const prerender = false;

const form = Astro.url.searchParams.get('form') ?? 'enquiry';
const error = Astro.url.searchParams.get('error');
const backRaw = Astro.url.searchParams.get('back') ?? '/';
const back = /^\/[\w\-\/]*$/.test(backRaw) ? backRaw : '/';
const messages: Record<string, string> = {
  enquiry: "Thank you, your enquiry is on its way. I'll reply within two working days.",
  commission: "Thank you! Your commission enquiry has arrived. I'll be in touch within two working days with a quote and a mood sketch.",
  subscribe: "You're on the list. I'll write to you first.",
};
const title = error ? 'Something needs a look' : 'Sent. Thank you!';
Astro.response.headers.set('Cache-Control', 'no-store');
---
<Base title={title} description="Form confirmation" noindex>
  <section class="container-x pt-16 text-center">
    <p class="eyebrow">{error ? 'Not sent' : 'Sent'}</p>
    <h1 class="mt-3 text-4xl md:text-5xl">{title}</h1>
    <p class="mx-auto mt-4 max-w-md text-lg text-muted">{error ?? messages[form] ?? messages.enquiry}</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href={back} class="btn btn-primary">{error ? 'Go back and try again' : 'Back'}</a>
      <a href="/work" class="btn btn-secondary">See the originals</a>
    </div>
  </section>
</Base>
