{
  "name": "samridhiagarwal-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "media:gen": "node scripts/gen-media.mjs",
    "deploy": "astro build && wrangler deploy",
    "screenshots": "node scripts/screenshots.mjs",
    "db:migrate:local": "wrangler d1 migrations apply samridhiagarwal --local",
    "db:migrate:remote": "wrangler d1 migrations apply samridhiagarwal --remote",
    "db:seed:local": "node scripts/seed-d1.mjs && wrangler d1 execute samridhiagarwal --local --file seed/out/seed.sql",
    "db:seed:remote": "node scripts/seed-d1.mjs && wrangler d1 execute samridhiagarwal --remote --file seed/out/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.6",
    "@astrojs/react": "^4.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20250925.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright-core": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.135.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
